{
  "name": "rite",
  "version": "0.2.0",
  "private": true,
  "description": "Rust & TypeScript Interface for Terminal Environment",
  "repository": "https://github.com/Altagen/Rite",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
