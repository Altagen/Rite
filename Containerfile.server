# rite-server production image — the team-deployment shell (ADR 0004/0005).
#
# Multi-stage: (1) build the frontend, (2) compile rite-server release with the
# frontend embedded, (3) ship a minimal runtime. rite-server is GUI-free, so no
# GTK/WebKit is needed here — unlike the desktop shell.
#
# Build:  podman build -f Containerfile.server -t rite-server:local .
# Run:    podman run --rm -p 1421:1421 rite-server:local
#
# Both build stages install their dependencies BEFORE copying the source, so a
# change to our code does not invalidate the layer that compiled six hundred
# crates. Paired with a registry cache in the release workflow, that is the
# difference between recompiling the world on every tag — twice, since arm64 goes
# through QEMU emulation — and recompiling four crates.

# The Rust the project is pinned to (rust-toolchain.toml). A Containerfile cannot
# read a file to choose its base image, so the release workflow passes this from
# that file; the default below is for local builds and must track it.
ARG RUST_VERSION=1.100.0
# The Node the project is pinned to (.node-version), for the same reason and with the
# same obligation: `node:24-...` was a floating major, so the bundle this image ships
# was built by whatever 24.x the registry held that day, while the host and CI were
# held to an exact version. The Pins job checks this against .node-version.
ARG NODE_VERSION=26.13.1

# --- Stage 1: build the frontend bundle ---
FROM node:${NODE_VERSION}-trixie-slim AS web
ENV CI=true
WORKDIR /app
# Manifests first: `pnpm install` re-runs when dependencies change, not when a
# component does. `packageManager` in package.json is the one place the pnpm version is
# written, so it comes from the repository like everywhere else (ADR 0020's neighbours).
#
# NOT COREPACK, since Node 26 dropped it: neither the official tarball nor this image
# carries it any more (measured — `command -v corepack` is empty in
# `node:26.13.1-trixie-slim`), so `corepack enable` fails and takes the build with it.
# The version is read out of the manifest and handed to npm instead, exactly as the
# validation image does it.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN npm i -g "$(sed -n 's/.*"packageManager" *: *"\([^"]*\)".*/\1/p' package.json)"
COPY apps/desktop/package.json apps/desktop/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter desktop build:frontend

# --- Stage 2: compile rite-server with the embedded frontend ---
# `.containerignore` excludes `.git`, so the build cannot ask what commit it is: a release
# passes it. Without it the binary reports `unknown`, which is the honest answer and the
# one a bug report can still work with.
#   podman build -f Containerfile.server --build-arg RITE_COMMIT=$(git rev-parse --short HEAD) .
ARG RITE_COMMIT=unknown
ARG RUST_VERSION
FROM rust:${RUST_VERSION}-trixie AS builder
ARG RITE_COMMIT
ENV RITE_COMMIT=${RITE_COMMIT}
WORKDIR /src

# The dependency graph, in a layer of its own. Manifests and a stub source tree are
# enough to compile every third-party crate; our four compile in seconds afterwards.
# The base image already carries the pinned toolchain, so copying rust-toolchain.toml
# here costs nothing — rustup finds what it asks for instead of downloading it once
# per architecture.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps/desktop/shell/Cargo.toml apps/desktop/shell/
COPY packages/crypto/Cargo.toml packages/crypto/
COPY packages/rite-core/Cargo.toml packages/rite-core/
COPY packages/rite-server/Cargo.toml packages/rite-server/
# `web/` has to exist or rust-embed fails at compile time (assets.rs, ADR 0004);
# empty is fine here, the real bundle arrives with the source below.
RUN mkdir -p apps/desktop/shell/src packages/crypto/src packages/rite-core/src \
             packages/rite-server/src packages/rite-server/web \
 && echo 'fn main() {}' > apps/desktop/shell/src/main.rs \
 && echo 'fn main() {}' > packages/rite-server/src/main.rs \
 && touch packages/crypto/src/lib.rs packages/rite-core/src/lib.rs \
          packages/rite-server/src/lib.rs \
 && cargo build --release -p rite-server \
 && rm -rf apps packages

COPY . .
# rust-embed reads packages/rite-server/web at compile time (ADR 0004).
COPY --from=web /app/apps/desktop/dist/. packages/rite-server/web/
# Our own sources arrive carrying their repository timestamps, which are older than the
# stub artefacts the cached layer above left in target/. Cargo judges freshness by mtime,
# so without this it declares the empty stub libraries up to date and links against them —
# rite-server then fails to find its own modules, and only because the layer was cached.
# The first build after a clean never shows it, which is what makes it worth a comment.
RUN find apps packages -name '*.rs' -exec touch {} + \
 && cargo build --release -p rite-server

# --- Stage 3: minimal runtime ---
# Pinned by digest: there is no version in this tag to pin instead, and the runtime
# is where a silently-changed base would ship. Dependabot's docker ecosystem moves it.
# The digest is the INDEX's, not one architecture's manifest — the release builds this
# image for amd64 and arm64 from the same line, and a per-arch digest would pin it to one
# of them and fail the other. (`skopeo inspect --raw` returns the index; its sha256 is
# this value.)
#
# TRIXIE, AND ALL THREE STAGES TOGETHER. Debian 13 is stable since 2025-08; bookworm is
# oldstable and its security window is the shorter one. The three bases move as a set
# because the binary built in the builder has to load in the runtime: rust:1.100.0-trixie
# and debian:trixie-slim are both GLIBC 2.41, and a builder left on trixie over a bookworm
# runtime (2.36) would fail at load, not at build.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --home-dir /home/rite --shell /usr/sbin/nologin rite
COPY --from=builder /src/target/release/rite-server /usr/local/bin/rite-server
USER rite
# The home, and not the default `/`. A local terminal opened from the web UI inherits this
# process's working directory — nothing makes a shell go to $HOME on its own — so without
# this line a member landed in `/`, which they cannot write to and which holds nothing of
# theirs. The data volume mounts under here too, so the one directory a session can use is
# the one it starts in. `e2e/server-image-check.mjs` holds it, and the same line is in the
# acceptance fixture: the test image has to start a shell where the real one does.
WORKDIR /home/rite
# Bind all interfaces so the container is reachable; the vault lives under the
# rite user's data dir (mount a volume at /home/rite/.local/share/rite to persist).
ENV RITE_ADDR=0.0.0.0:1421
EXPOSE 1421
ENTRYPOINT ["/usr/local/bin/rite-server"]
