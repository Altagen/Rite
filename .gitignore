# Rust
target/
**/*.rs.bk
*.pdb

# Node.js / pnpm
node_modules/
dist/
.pnpm-debug.log*
.pnpm-store/

# Build outputs
*.tar.gz
*.zip
*.dmg
*.deb
*.rpm
*.AppImage

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.claude/

# Logs
*.log
logs/

# Environment
.env
.env.local

# Database (dev)
*.db
*.db-shm
*.db-wal

# User data (don't commit user configs)
.config/
.local/

# Temporary files
tmp/
temp/

# rite-server embedded frontend (copied from apps/desktop/dist at build time)
/packages/rite-server/web/*
!/packages/rite-server/web/.gitkeep

# Playwright e2e artifacts
/e2e/report/
/test-results/
/playwright-report/

# Local deployment material — a password and a private key, generated by the
# reader following docs/SERVER.md. Neither belongs in the repository, and the
# compose files reference them by path precisely so they stay out.
deploy/admin_password.txt
deploy/tls/
